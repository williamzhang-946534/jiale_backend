import { Controller, Get, Query, Req, UseGuards } from '@nestjs/common';
import { JwtAuthGuard } from '../shared/guards/jwt-auth.guard';
import { RoleGuard } from '../shared/guards/role.guard';
import { PrismaService } from '../shared/services/prisma.service';
import { ProviderStatsService } from './provider-stats.service';
import { BankCardService } from './bank-card.service';
import { ok } from '../shared/types/api-response';

@Controller('v1/provider')
@UseGuards(JwtAuthGuard, new RoleGuard(['PROVIDER']))
export class ProviderWalletController {
  constructor(
    private readonly prisma: PrismaService,
    private readonly providerStats: ProviderStatsService,
    private readonly bankCardService: BankCardService,
  ) {}

  @Get('schedule')
  async getSchedule(@Req() req: any, @Query() query: { month?: string }) {
    const { month } = query;

    const provider = await this.prisma.provider.findFirst({
      where: { userId: req.user.id },
    });

    if (!provider) {
      throw new Error('服务者账号不存在');
    }

    // 解析月份参数，默认为当前月份
    const targetMonth = month ? new Date(month) : new Date();
    const startDate = new Date(targetMonth.getFullYear(), targetMonth.getMonth(), 1);
    const endDate = new Date(targetMonth.getFullYear(), targetMonth.getMonth() + 1, 0);

    // 获取该月份的订单
    const orders = await this.prisma.order.findMany({
      where: {
        providerId: provider.id,
        serviceDate: {
          gte: startDate,
          lte: endDate,
        },
      },
      include: {
        service: true,
        user: true,
        address: true,
      },
      orderBy: {
        serviceDate: 'asc',
      },
    });

    // 获取服务者排班
    const schedules = await this.prisma.providerSchedule.findMany({
      where: {
        providerId: provider.id,
        date: {
          gte: startDate,
          lte: endDate,
        },
      },
      orderBy: {
        date: 'asc',
      },
    });

    const data = {
      month: targetMonth.toISOString().slice(0, 7),
      orders: orders.map((order) => ({
        id: order.id,
        date: order.serviceDate.toISOString().split('T')[0],
        time: order.serviceTime,
        serviceName: order.service.name,
        customerName: order.user.nickname || order.user.phone,
        status: order.status,
        price: order.totalPrice,
        address: `${order.address.province} ${order.address.city} ${order.address.district}`,
      })),
      schedules: schedules.map((schedule) => ({
        date: schedule.date.toISOString().split('T')[0],
        slots: schedule.slots,
      })),
    };

    return ok(data);
  }

  @Get('wallet')
  async getWallet(@Req() req: any) {
    const provider = await this.prisma.provider.findFirst({
      where: { userId: req.user.id },
      include: {
        transactions: {
          orderBy: { createdAt: 'desc' },
          take: 20,
          include: {
            order: {
              include: {
                service: true,
                user: {
                  select: {
                    nickname: true,
                    phone: true
                  }
                }
              }
            }
          }
        },
        withdrawals: {
          where: { status: 'PENDING' },
        },
      },
    });

    if (!provider) {
      throw new Error('服务者账号不存在');
    }

    // 🎯 使用实时计算的准确今日收入
    const accurateTodayEarnings = await this.providerStats.getAccurateTodayEarnings(provider.id);

    // 🎯 获取银行卡信息
    const bankCardsResult = await this.bankCardService.getBankCards(req.user.id);
    const bankCards = (bankCardsResult.data as any[]) || [];
    const defaultBankCard = bankCards.find((card: any) => card.isDefault);

    // 🎯 统一数据源：使用 ProviderDailyStats 表计算月收入
    const currentMonthStart = new Date(new Date().getFullYear(), new Date().getMonth(), 1);
    const monthlyIncome = await this.prisma.providerDailyStats.aggregate({
      where: {
        providerId: provider.id,
        date: {
          gte: currentMonthStart,
        },
      },
      _sum: {
        earnings: true,
        orderCount: true,
      },
    });

    // 📊 获取本月详细统计信息（用于调试和验证）
    const monthlyStats = await this.prisma.providerDailyStats.findMany({
      where: {
        providerId: provider.id,
        date: {
          gte: currentMonthStart,
        },
      },
      orderBy: {
        date: 'asc',
      },
    });

    // 🎯 构建丰富的钱包信息
    const walletInfo = {
      // 基础信息
      id: provider.id,
      name: provider.name,
      phone: provider.phone,
      walletBalance: provider.walletBalance,
      withdrawableBalance: provider.withdrawableBalance,
      todayEarnings: accurateTodayEarnings, // 🎯 使用实时计算的准确今日收入
      totalOrders: provider.totalOrders,
      totalRevenue: provider.totalRevenue,
      
      // 🆕 新增字段
      monthlyEarnings: monthlyIncome._sum.earnings || 0,
      monthlyOrders: monthlyIncome._sum.orderCount || 0, // 🆕 新增月订单数
      pendingWithdrawals: provider.withdrawals.reduce((sum, w) => sum + w.amount.toNumber(), 0),
      frozenAmount: 0, // 🆕 冻结金额，当前为0
      totalEarnings: provider.totalRevenue, // 🆕 总收入
      bankCardsCount: bankCards.length, // 🆕 银行卡数量
      defaultBankCard: defaultBankCard ? { // 🆕 默认银行卡信息
        id: defaultBankCard.id,
        bankName: defaultBankCard.bankName,
        maskedCardNumber: defaultBankCard.maskedCardNumber
      } : null,
      transactions: provider.transactions.map((transaction) => {
        // 🎨 丰富的交易信息
        const enrichedTransaction = {
          // 基础信息
          id: transaction.id,
          type: transaction.type,
          amount: transaction.amount,
          beforeBalance: transaction.beforeBalance,
          afterBalance: transaction.afterBalance,
          createdAt: transaction.createdAt,
          
          // 🎨 关联信息
          order: transaction.order ? {
            id: transaction.order.id,
            status: transaction.order.status,
            totalAmount: transaction.order.totalPrice || 0,
            service: transaction.order.service ? {
              id: transaction.order.service.id,
              name: transaction.order.service.name,
              category: transaction.order.service.type || 'other',
              price: transaction.order.service.price,
            } : null,
            user: transaction.order.user ? {
              nickname: transaction.order.user.nickname,
              phone: transaction.order.user.phone,
            } : null,
          } : null,
          
          // 🎨 交易描述和状态
          description: this.getTransactionDescription(transaction),
          status: this.getTransactionStatus(transaction),
          icon: this.getTransactionIcon(transaction.type),
          color: this.getTransactionColor(transaction.type),
          
          // 🆕 额外标识
          isToday: new Date(transaction.createdAt).toDateString() === new Date().toDateString(),
          isIncome: transaction.type === 'INCOME',
          isWithdrawal: transaction.type === 'WITHDRAWAL',
          isRefund: transaction.type === 'REFUND'
        };
        
        return enrichedTransaction;
      }),
      
      // 📊 调试信息
      debug: {
        monthlyStats: monthlyStats,
        accurateTodayEarnings,
        currentMonthStart,
      },
    };

    return ok(walletInfo);
  }

  @Get('wallet/chart')
  async getWalletChart(@Req() req: any, @Query() query: { period?: 'week' | 'month' | 'year' }) {
    const { period = 'week' } = query;
    
    const provider = await this.prisma.provider.findFirst({
      where: { userId: req.user.id },
    });

    if (!provider) {
      throw new Error('服务者账号不存在');
    }

    try {
      if (period === 'week') {
        // 🎯 最近7天的数据
        const endDate = new Date();
        const startDate = new Date();
        startDate.setDate(startDate.getDate() - 6); // 最近7天包括今天
        startDate.setHours(0, 0, 0, 0);
        endDate.setHours(23, 59, 59, 999);
        
        // 获取最近7天的每日统计
        const weeklyStats = await this.prisma.providerDailyStats.findMany({
          where: {
            providerId: provider.id,
            date: {
              gte: startDate,
              lte: endDate,
            },
          },
          orderBy: {
            date: 'asc',
          },
        });

        // 生成最近7天的标签和值
        const labels: string[] = [];
        const values: number[] = [];
        
        for (let i = 0; i < 7; i++) {
          const currentDate = new Date(startDate);
          currentDate.setDate(startDate.getDate() + i);
          currentDate.setHours(0, 0, 0, 0);
          
          // 格式化日期标签 (MM-DD)
          const month = (currentDate.getMonth() + 1).toString().padStart(2, '0');
          const day = currentDate.getDate().toString().padStart(2, '0');
          labels.push(`${month}-${day}`);
          
          // 查找当天的统计数据
          const dayStats = weeklyStats.find(stat => {
            const statDate = new Date(stat.date);
            statDate.setHours(0, 0, 0, 0);
            return statDate.getTime() === currentDate.getTime();
          });
          
          values.push(dayStats ? dayStats.earnings.toNumber() : 0);
        }
        
        const totalEarnings = values.reduce((sum, val) => sum + val, 0);
        const nonZeroValues = values.filter(v => v > 0);
        
        // 🎨 周度图表增强数据
        const enhancedData = {
          period: 'week',
          labels,
          values,
          totalEarnings,
          totalOrders: weeklyStats.reduce((sum, stat) => sum + stat.orderCount, 0),
          startDate,
          endDate,
          // 📊 增加格式化的货币显示
          formattedValues: values.map(value => `¥${value.toLocaleString()}`),
          // 📈 增加趋势分析
          trend: this.calculateTrend(values),
          // 🎯 增加最高/最低收入日
          maxEarning: {
            day: labels[values.indexOf(Math.max(...values))],
            amount: Math.max(...values)
          },
          minEarning: {
            day: labels[values.findIndex(v => v > 0)],
            amount: Math.min(...nonZeroValues)
          },
          // 📊 增加平均值
          averageEarning: nonZeroValues.length > 0 ? Math.round(totalEarnings / nonZeroValues.length) : 0,
          workingDays: nonZeroValues.length,
          // 🎨 增加颜色主题
          theme: {
            primary: '#4F46E5',
            success: '#10B981',
            warning: '#F59E0B',
            danger: '#EF4444'
          },
          // 📈 增加数据点详细信息
          dataPoints: labels.map((label, index) => ({
            day: label,
            value: values[index],
            formattedValue: `¥${values[index].toLocaleString()}`,
            hasData: values[index] > 0,
            percentage: totalEarnings > 0 
              ? Math.round((values[index] / totalEarnings) * 100) 
              : 0
          }))
        };
        
        return ok(enhancedData);
      } else if (period === 'month') {
        // 🎯 最近30天的数据
        const endDate = new Date();
        const startDate = new Date();
        startDate.setDate(startDate.getDate() - 29); // 最近30天包括今天
        startDate.setHours(0, 0, 0, 0);
        endDate.setHours(23, 59, 59, 999);
        
        // 获取最近30天的每日统计
        const monthlyStats = await this.prisma.providerDailyStats.findMany({
          where: {
            providerId: provider.id,
            date: {
              gte: startDate,
              lte: endDate,
            },
          },
          orderBy: {
            date: 'asc',
          },
        });

        // 生成最近30天的标签和值
        const labels: string[] = [];
        const values: number[] = [];
        
        for (let i = 0; i < 30; i++) {
          const currentDate = new Date(startDate);
          currentDate.setDate(startDate.getDate() + i);
          currentDate.setHours(0, 0, 0, 0);
          
          // 格式化日期标签 (MM-DD)
          const month = (currentDate.getMonth() + 1).toString().padStart(2, '0');
          const day = currentDate.getDate().toString().padStart(2, '0');
          labels.push(`${month}-${day}`);
          
          // 查找当天的统计数据
          const dayStats = monthlyStats.find(stat => {
            const statDate = new Date(stat.date);
            statDate.setHours(0, 0, 0, 0);
            return statDate.getTime() === currentDate.getTime();
          });
          
          values.push(dayStats ? dayStats.earnings.toNumber() : 0);
        }

        const totalEarnings = values.reduce((sum, val) => sum + val, 0);
        const nonZeroValues = values.filter(v => v > 0);
        
        // 🎨 月度图表增强数据
        const enhancedMonthlyData = {
          period: 'month',
          labels,
          values,
          totalEarnings,
          totalOrders: monthlyStats.reduce((sum, stat) => sum + stat.orderCount, 0),
          startDate,
          endDate,
          // 📊 增加格式化显示
          formattedValues: values.map(value => `¥${value.toLocaleString()}`),
          // 📈 趋势分析
          trend: this.calculateTrend(values),
          // 🎯 最高/最低收入日
          maxEarning: {
            day: labels[values.indexOf(Math.max(...values))],
            amount: Math.max(...values)
          },
          minEarning: {
            day: labels[values.findIndex(v => v > 0)],
            amount: Math.min(...nonZeroValues)
          },
          // 📊 统计信息
          averageEarning: nonZeroValues.length > 0 ? Math.round(totalEarnings / nonZeroValues.length) : 0,
          workingDays: nonZeroValues.length,
          // 🎨 主题色彩
          theme: {
            primary: '#4F46E5',
            success: '#10B981',
            warning: '#F59E0B',
            danger: '#EF4444'
          },
          // 📈 数据点详细信息
          dataPoints: labels.map((label, index) => ({
            day: label,
            value: values[index],
            formattedValue: `¥${values[index].toLocaleString()}`,
            hasData: values[index] > 0,
            percentage: totalEarnings > 0 
              ? Math.round((values[index] / totalEarnings) * 100) 
              : 0
          }))
        };

        return ok(enhancedMonthlyData);
      } else if (period === 'year') {
        // 🎯 最近12个月的数据
        const endDate = new Date();
        const startDate = new Date();
        startDate.setMonth(startDate.getMonth() - 11); // 最近12个月包括本月
        startDate.setDate(1); // 月初
        startDate.setHours(0, 0, 0, 0);
        endDate.setHours(23, 59, 59, 999);
        
        // 获取最近12个月的月度统计（聚合每日统计数据）
        const yearlyStats = await this.prisma.providerDailyStats.findMany({
          where: {
            providerId: provider.id,
            date: {
              gte: startDate,
              lte: endDate,
            },
          },
          orderBy: {
            date: 'asc',
          },
        });

        // 按月聚合数据
        const monthlyData = new Map<string, { earnings: number; orders: number }>();
        
        // 初始化12个月的数据
        for (let i = 0; i < 12; i++) {
          const currentDate = new Date(startDate);
          currentDate.setMonth(startDate.getMonth() + i);
          const monthKey = `${currentDate.getFullYear()}-${(currentDate.getMonth() + 1).toString().padStart(2, '0')}`;
          monthlyData.set(monthKey, { earnings: 0, orders: 0 });
        }
        
        // 聚合每日数据到月度
        yearlyStats.forEach(stat => {
          const date = new Date(stat.date);
          const monthKey = `${date.getFullYear()}-${(date.getMonth() + 1).toString().padStart(2, '0')}`;
          const monthData = monthlyData.get(monthKey);
          if (monthData) {
            monthData.earnings += stat.earnings.toNumber();
            monthData.orders += stat.orderCount;
          }
        });

        // 生成最近12个月的标签和值
        const labels: string[] = [];
        const values: number[] = [];
        const orderCounts: number[] = [];
        
        for (let i = 0; i < 12; i++) {
          const currentDate = new Date(startDate);
          currentDate.setMonth(startDate.getMonth() + i);
          const monthKey = `${currentDate.getFullYear()}-${(currentDate.getMonth() + 1).toString().padStart(2, '0')}`;
          const monthData = monthlyData.get(monthKey);
          
          // 格式化月份标签 (YYYY-MM)
          labels.push(monthKey);
          values.push(monthData ? monthData.earnings : 0);
          orderCounts.push(monthData ? monthData.orders : 0);
        }

        const totalEarnings = values.reduce((sum, val) => sum + val, 0);
        const nonZeroValues = values.filter(v => v > 0);
        
        // 🎨 年度图表增强数据
        const enhancedYearlyData = {
          period: 'year',
          labels,
          values,
          orderCounts,
          totalEarnings,
          totalOrders: orderCounts.reduce((sum, val) => sum + val, 0),
          startDate,
          endDate,
          // 📊 增加格式化显示
          formattedValues: values.map(value => `¥${value.toLocaleString()}`),
          // 📈 趋势分析
          trend: this.calculateTrend(values),
          // 🎯 最高/最低收入月
          maxEarning: {
            month: labels[values.indexOf(Math.max(...values))],
            amount: Math.max(...values)
          },
          minEarning: {
            month: labels[values.findIndex(v => v > 0)],
            amount: Math.min(...nonZeroValues)
          },
          // 📊 统计信息
          averageEarning: nonZeroValues.length > 0 ? Math.round(totalEarnings / nonZeroValues.length) : 0,
          workingMonths: nonZeroValues.length,
          // 🎨 主题色彩
          theme: {
            primary: '#4F46E5',
            success: '#10B981',
            warning: '#F59E0B',
            danger: '#EF4444'
          },
          // 📈 数据点详细信息
          dataPoints: labels.map((label, index) => ({
            month: label,
            value: values[index],
            orderCount: orderCounts[index],
            formattedValue: `¥${values[index].toLocaleString()}`,
            hasData: values[index] > 0,
            percentage: totalEarnings > 0 
              ? Math.round((values[index] / totalEarnings) * 100) 
              : 0
          }))
        };

        return ok(enhancedYearlyData);
      } else {
        // 不支持的周期参数
        throw new Error('不支持的周期参数，仅支持 week、month、year');
      }
    } catch (error) {
      console.error('钱包图表查询失败:', error);
      
      // 如果查询失败，返回空数据
      let labels: string[];
      if (period === 'week') {
        labels = [];
        for (let i = 6; i >= 0; i--) {
          const date = new Date();
          date.setDate(date.getDate() - i);
          const month = (date.getMonth() + 1).toString().padStart(2, '0');
          const day = date.getDate().toString().padStart(2, '0');
          labels.push(`${month}-${day}`);
        }
      } else if (period === 'month') {
        labels = [];
        for (let i = 29; i >= 0; i--) {
          const date = new Date();
          date.setDate(date.getDate() - i);
          const month = (date.getMonth() + 1).toString().padStart(2, '0');
          const day = date.getDate().toString().padStart(2, '0');
          labels.push(`${month}-${day}`);
        }
      } else {
        labels = [];
        const date = new Date();
        for (let i = 11; i >= 0; i--) {
          const currentDate = new Date(date);
          currentDate.setMonth(date.getMonth() - i);
          labels.push(`${currentDate.getFullYear()}-${(currentDate.getMonth() + 1).toString().padStart(2, '0')}`);
        }
      }
      
      return ok({
        period,
        labels,
        values: new Array(labels.length).fill(0),
        formattedValues: new Array(labels.length).fill('¥0'),
        trend: { direction: 'stable', percentage: 0 },
        maxEarning: period === 'year' ? { month: '-', amount: 0 } : { day: '-', amount: 0 },
        minEarning: period === 'year' ? { month: '-', amount: 0 } : { day: '-', amount: 0 },
        averageEarning: 0,
        workingDays: 0,
        theme: {
          primary: '#4F46E5',
          success: '#10B981',
          warning: '#F59E0B',
          danger: '#EF4444'
        },
        dataPoints: labels.map((label, index) => ({
          [period === 'year' ? 'month' : 'day']: label,
          value: 0,
          formattedValue: '¥0',
          hasData: false,
          percentage: 0
        }))
      });
    }
        averageEarning: 0,
        theme: {
          primary: '#4F46E5',
          success: '#10B981',
          warning: '#F59E0B',
          danger: '#EF4444'
        },
        dataPoints: labels.map(label => ({
          day: label,
          value: 0,
          formattedValue: '¥0',
          hasData: false,
          percentage: 0
        }))
      });
    }
  }

  /**
   * 📈 计算数据趋势 - 优化版本，提供更清晰的业务含义
   */
  private calculateTrend(values: number[]): { 
    direction: 'up' | 'down' | 'stable', 
    percentage: number,
    description: string,
    confidence: number,
    details: {
      average: number,
      max: number,
      min: number,
      variance: number,
      growthRate: number
    }
  } {
    const nonZeroValues = values.filter(v => v > 0);
    
    if (nonZeroValues.length < 2) {
      return {
        direction: 'stable',
        percentage: 0,
        description: '数据不足，无法计算趋势',
        confidence: 0,
        details: {
          average: 0,
          max: 0,
          min: 0,
          variance: 0,
          growthRate: 0
        }
      };
    }

    // 计算基本统计信息
    const average = nonZeroValues.reduce((sum, val) => sum + val, 0) / nonZeroValues.length;
    const max = Math.max(...nonZeroValues);
    const min = Math.min(...nonZeroValues);
    const variance = nonZeroValues.reduce((sum, val) => sum + Math.pow(val - average, 2), 0) / nonZeroValues.length;
    
    // 计算趋势（基于最近3天vs之前3天的平均值）
    const recentDays = nonZeroValues.slice(-3);
    const previousDays = nonZeroValues.slice(-6, -3);
    
    if (previousDays.length === 0) {
      return {
        direction: 'stable',
        percentage: 0,
        description: '数据不足，无法计算趋势',
        confidence: 0.3,
        details: { average, max, min, variance, growthRate: 0 }
      };
    }

    const recentAvg = recentDays.reduce((sum, val) => sum + val, 0) / recentDays.length;
    const previousAvg = previousDays.reduce((sum, val) => sum + val, 0) / previousDays.length;
    
    const growthRate = previousAvg > 0 ? ((recentAvg - previousAvg) / previousAvg) * 100 : 0;
    
    // 确定趋势方向和描述
    let direction: 'up' | 'down' | 'stable';
    let description: string;
    let confidence: number;
    
    if (Math.abs(growthRate) < 5) {
      direction = 'stable';
      description = '收入保持稳定';
      confidence = 0.8;
    } else if (growthRate > 0) {
      direction = 'up';
      description = `收入呈上升趋势，增长${Math.round(growthRate)}%`;
      confidence = Math.min(0.9, 0.5 + (Math.abs(growthRate) / 50));
    } else {
      direction = 'down';
      description = `收入呈下降趋势，下降${Math.round(Math.abs(growthRate))}%`;
      confidence = Math.min(0.9, 0.5 + (Math.abs(growthRate) / 50));
    }

    return {
      direction,
      percentage: Math.round(growthRate),
      description,
      confidence,
      details: {
        average: Math.round(average),
        max,
        min,
        variance: Math.round(variance),
        growthRate: Math.round(growthRate)
      }
    };
  }

  /**
   * 📝 获取交易描述 - 增强版本，提供更详细的描述
   */
  private getTransactionDescription(transaction: any): string {
    switch (transaction.type) {
      case 'INCOME':
        if (transaction.order) {
          return `完成订单：${transaction.order.service?.name || '服务'}`;
        }
        return '订单收入';
      case 'WITHDRAWAL':
        return '提现到银行卡';
      case 'REFUND':
        return '订单退款';
      case 'BONUS':
        return '平台奖励';
      case 'PENALTY':
        return '平台罚款';
      default:
        return '其他交易';
    }
  }

  /**
   * 🏷️ 获取交易状态
   */
  private getTransactionStatus(transaction: any): string {
    // 根据交易类型和金额判断状态
    if (transaction.type === 'INCOME') {
      return '已完成';
    } else if (transaction.type === 'WITHDRAWAL') {
      return '处理中';
    } else if (transaction.type === 'REFUND') {
      return '已退款';
    }
    return '已完成';
  }

  /**
   * 🎨 获取交易图标
   */
  private getTransactionIcon(type: string): string {
    const iconMap: { [key: string]: string } = {
      'INCOME': '💰',
      'WITHDRAWAL': '💸',
      'REFUND': '🔄',
      'BONUS': '🎁',
      'PENALTY': '⚠️'
    };
    return iconMap[type] || '📄';
  }

  /**
   * 🎨 获取交易颜色
   */
  private getTransactionColor(type: string): string {
    const colorMap: { [key: string]: string } = {
      'INCOME': '#10B981',  // 绿色
      'WITHDRAWAL': '#F59E0B',  // 橙色
      'REFUND': '#EF4444',  // 红色
      'BONUS': '#8B5CF6',  // 紫色
      'PENALTY': '#EF4444'  // 红色
    };
    return colorMap[type] || '#6B7280';  // 默认灰色
  }
}
